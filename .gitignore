# ============================================================
# TOURISM INTEL — .gitignore
# ============================================================

# ----------------------------
# Environment / Secrets (NEVER commit these)
# ----------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging
*.secret
*.secrets

# ----------------------------
# Node.js / Frontend
# ----------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/

# Vite build output (generated — do not commit)
dist/
dist-ssr/
*.local

# ----------------------------
# Python / Backend
# ----------------------------
# Virtual environments
venv/
env/
.venv/
.env_backend/
backend_env/
__pyenv__/


# Distribution / packaging
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# pytest / testing cache
.pytest_cache/
.coverage
htmlcov/
*.log

# mypy / type checking
.mypy_cache/
.dmypy.json
dmypy.json

# ----------------------------
# SQLite Database (runtime-generated — do not commit)
# ----------------------------
backend/database/*.db
backend/database/*.db-journal
backend/database/*.db-shm
backend/database/*.db-wal

# ----------------------------
# IDE & Editor Files
# ----------------------------
# VS Code
.vscode/
*.code-workspace

# JetBrains / PyCharm / WebStorm
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*~
.#*
\#*#

# ----------------------------
# Operating System Files
# ----------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ----------------------------
# Logs
# ----------------------------
logs/
*.log
pip-log.txt
pip-delete-this-directory.txt

# ----------------------------
# Coverage & Testing Artifacts
# ----------------------------
coverage/
.nyc_output/
lcov.info

# ----------------------------
# Miscellaneous Build Artifacts
# ----------------------------
*.map
.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/
.output/
.vercel/
.netlify/
