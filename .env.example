# ============================================================
# TOURISM INTEL — Environment Variables Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your own values below.
#   3. NEVER commit your .env file — it is listed in .gitignore.
# ============================================================


# -----------------------------------------------
# FRONTEND — Vite (prefix VITE_ to expose to React)
# -----------------------------------------------

# Google Maps JavaScript API Key
# Required for: Navigate page map, GPS, route rendering, safe corridor
# Get yours at: https://console.cloud.google.com/google/maps-apis/credentials
# Enable: Maps JavaScript API, Directions API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend API base URL (Vite proxy rewrites /api/* automatically in dev)
# Leave as default for local development. Change for remote deployments.
VITE_API_BASE_URL=http://localhost:5000


# -----------------------------------------------
# BACKEND — Flask (loaded via os.getenv)
# -----------------------------------------------

# Flask application environment
# Values: development | production | testing
FLASK_ENV=development

# Flask secret key — used for session signing
# Generate a strong random key for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret-key

# Database URL (SQLite default — no setup needed for local development)
# To use PostgreSQL: postgresql://user:password@localhost:5432/tourism_intel
# Leave blank to use the default SQLite database at backend/database/tourism_intel.db
DATABASE_URL=

# Allowed CORS origins (comma-separated, no spaces)
# Default covers both Vite dev ports
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
